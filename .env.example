# Copy this file to .env for local runs. On Railway / Render / Docker hosts, set these as
# environment variables instead. NEVER commit your real .env.

# ── Telegram (required) ─────────────────────────────────────────────
API_ID=
API_HASH=
BOT_TOKEN=
# Pyrogram/Kurigram string session of the ASSISTANT account (a normal Telegram account
# that joins voice chats). Generate it with:  python -m bot.session
STRING_SESSION=
# Optional extra assistants for heavy use (each group is always served by the same one)
STRING_SESSION2=
STRING_SESSION3=
# Your Telegram user ID (comma-separate for several owners). Get it from @userinfobot
OWNER_ID=

# ── Your music API (required) ───────────────────────────────────────
# Address of your deployed API and the key from its /portal page
API_URL=https://your-api.example.com
API_KEY=

# ── Look and feel (optional) ────────────────────────────────────────
BOT_NAME=Shubh Music
SUPPORT_CHAT=
SUPPORT_CHANNEL=
START_IMG_URL=
# A chat/channel ID where the bot reports new users, new groups and errors (bot must be in it)
LOG_CHAT_ID=

# ── Behaviour (optional, sensible defaults) ─────────────────────────
DATA_DIR=data
TIMEZONE=Asia/Kolkata
DURATION_LIMIT_MIN=600
MAX_QUEUE=50
PLAYLIST_IMPORT_LIMIT=25
AUTO_LEAVE_SECONDS=300
# Max songs one group may start per day (0 = unlimited). Protects your API quota.
PLAYS_PER_CHAT_PER_DAY=0
COMMAND_COOLDOWN_SECONDS=1.5
SONG_MAX_MB=100
# Hosting platforms that need an open port (Railway, Render...) set PORT automatically.
HEALTH_SERVER=true
LOG_LEVEL=INFO
